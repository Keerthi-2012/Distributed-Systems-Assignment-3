# ---- secrets -------------------------------------------------------------
.env
.env.*

# ---- personal notes and helpers (local only, not part of the submission) --
# EXPLAIN.md: my own notes for explaining each question - never pushed
EXPLAIN.md
**/EXPLAIN.md
rce.sh
# course handouts
*.pdf
# ...but our own report is part of the submission
!report.pdf
General Instructions.md
MapreduceForLocalTesting.sh
Mapreduce_distributed.sh

# ---- generated: rebuilt by `make` and the scripts -------------------------
# data/ holds the datasets. It sits at Section2 level, not inside a question,
# because Q1 and Q2 must measure the SAME bytes for the report's comparison to
# mean anything (Q1_mapreduce/results/dataset_md5.txt records the checksums).
# Q1's generator writes it: cd Section2/Q1_mapreduce && bash scripts/make_data.sh
Section2/data/
Section2/Q1_mapreduce/bin/
Section2/Q1_mapreduce/logs/
Section2/Q2_grpc/logs/
# Slurm's own job logs (results/q1_bench_<jobid>.log). The numbers that matter
# are extracted into the .csv files, which ARE tracked.
Section2/*/results/*_[0-9]*.log
*.o
*.pyc
__pycache__/

# Generated gRPC stubs: regenerated by Q2_grpc/scripts/setup_python.sh, and the
# generated code refuses to load unless it matches the installed grpcio version, so
# shipping them would only cause version mismatches on another machine.
Section2/Q2_grpc/src/loganalytics_pb2.py
Section2/Q2_grpc/src/loganalytics_pb2_grpc.py

# ---- Python --------------------------------------------------------------
.venv/
venv/

# ---- Slurm job output ----------------------------------------------------
slurm-*.out
q2grpc_*.log
Section2/results/*_bench_*.log
Section2/results/rce_*

# ---- editor / OS ---------------------------------------------------------
.vscode/
.idea/
.DS_Store
*.swp

# generated for the editor, so it can resolve the C++ headers
compile_commands.json

# ---- report build directory ------------------------------------------------
# The LaTeX working directory. report.pdf at the repository ROOT is the
# deliverable and is tracked; everything used to build it is not.
report_build/

# ---- benchmark by-products, not results ------------------------------------
# The reducer's raw output matrices: 8.9 MB of numbers nobody reads. The
# answers are checked by verify.py as the benchmark runs, and the timings that
# matter are extracted into the CSVs, which ARE tracked.
Q1/perf_results/output_*.txt
# Slurm's own per-job logs.
Q1/perf_results/*_[0-9]*.out
Q1/perf_results/*_[0-9]*.err

# ---- generated gRPC stubs for Q3 -------------------------------------------
# Same reason as Q2's stubs: generated code refuses to load unless it matches
# the installed grpcio version, so it is regenerated on each machine with
#   python3 -m grpc_tools.protoc -I. --python_out=. --grpc_python_out=. food_ordering.proto
Q3/food_ordering_pb2.py
Q3/food_ordering_pb2_grpc.py

# ---- LaTeX sources and intermediates ---------------------------------------
# Each question ships only its finished report.pdf. The .tex it was built from
# and everything pdflatex leaves behind stay out of the repository.
*.tex
*.aux
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk

# ---- markdown reports ------------------------------------------------------
# Superseded by each question's report.pdf, so there is only ever one write-up
# per question and the two cannot drift apart.
report.md
REPORT.md
