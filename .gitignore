# ---- generated: rebuilt by `make` and the scripts -------------------------
# data/ holds the datasets. It sits at Section2 level, not inside a question,
# because Q1 and Q2 must measure the SAME bytes for the report's comparison to
# mean anything (Q1_mapreduce/results/dataset_md5.txt records the checksums).
# Q1's generator writes it: cd Section2/Q1_mapreduce && bash scripts/make_data.sh
Section2/data/
Section2/Q1_mapreduce/bin/
Section2/Q1_mapreduce/logs/
Section2/Q2_grpc/logs/
# Slurm's own job logs (results/q1_bench_<jobid>.log). The numbers that matter
# are extracted into the .csv files, which ARE tracked.
Section2/*/results/*_[0-9]*.log
*.o
*.pyc
__pycache__/

# Generated gRPC stubs: regenerated by Q2_grpc/scripts/setup_python.sh, and the
# generated code refuses to load unless it matches the installed grpcio version, so
# shipping them would only cause version mismatches on another machine.
Section2/Q2_grpc/src/loganalytics_pb2.py
Section2/Q2_grpc/src/loganalytics_pb2_grpc.py

# ---- Python --------------------------------------------------------------
.venv/
venv/

# ---- Slurm job output ----------------------------------------------------
slurm-*.out
q2grpc_*.log
Section2/results/*_bench_*.log
Section2/results/rce_*

